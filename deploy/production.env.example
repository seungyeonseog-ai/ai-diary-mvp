# .env.production으로 복사 후 값을 채운다. 비밀값은 Git에 넣지 않는다.
COMPOSE_PROJECT_NAME=matabus-pilot
WEB_PORT=18000
MATABUS_IMAGE=matabus-local:pilot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# 별도 난수 생성기로 32자 이상 생성한다.
SECRET_KEY=
# 파일럿 계측. 서버에서 계정을 만든 뒤 해당 DB 사용자 ID를 쉼표로 구분해 입력한다.
POSTHOG_ENVIRONMENT=pilot
POSTHOG_HOST=
POSTHOG_PROJECT_TOKEN=
POSTHOG_ID_KEY=
POSTHOG_TEST_USER_IDS=
POSTHOG_PILOT_USER_IDS=
